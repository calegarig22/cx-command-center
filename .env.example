# Variáveis das funções serverless (Vercel → Settings → Environment Variables).
# Nunca coloque a service_role no frontend (web/config.js).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=
# Opcional: Incoming Webhook do Slack (também configurável no Painel Admin)
SLACK_WEBHOOK=
# Opcional: protege os endpoints de cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Opcional: protege /api/cancelamento-intake (header X-Intake-Secret)
INTAKE_SECRET=

# Versão Streamlit (local)
CX_DEMO_PASSWORD=
CX_INSTITUICAO=Escola de Idiomas Exemplo
CX_MANTENEDORA=Escola de Idiomas Exemplo Ltda
CX_CNPJ_MANTENEDORA=00.000.000/0001-00
CX_CNPJ_INSTITUICAO=00.000.000/0001-00
CX_CIDADE=São Paulo
CX_ENDERECO=Cidade – UF
